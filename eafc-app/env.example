# API base URL - copy to .env and adjust for YOUR setup:
#
# iOS Simulator:        http://localhost:3000
# Android Emulator:     http://10.0.2.2:3000
# Physical device       (same WiFi as your Mac): http://YOUR_MAC_IP:3000
#                       Run backend, it prints "On same WiFi, use: http://192.168.x.x:3000"
# Remote / different    Run: ngrok http 3000  then use the ngrok URL
# country:
#
EXPO_PUBLIC_API_URL=http://localhost:3000
